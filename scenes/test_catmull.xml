<world>
    <window width="1000" height="800"/>

    <camera>
        <position x="8" y="6" z="8"/>
        <lookAt x="0" y="0" z="0"/>
        <up x="0" y="1" z="0"/>
        <projection fov="60" near="1" far="1000"/>
    </camera>

    <group>
        <transform>
            <translate time="8" align="true">
                <point x="-4" y="0" z="-4"/>
                <point x="-4" y="0" z="4"/>
                <point x="4" y="0" z="4"/>
                <point x="4" y="0" z="-4"/>
            </translate>
            <rotate time="4" x="0" y="1" z="0"/>
            <scale x="0.7" y="0.7" z="0.7"/>
        </transform>
        <models>
            <model file="sphere.3d"/>
        </models>
    </group>
</world>
